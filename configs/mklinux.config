CONFIG_MULTIKERNEL=y
CONFIG_MKTTY=y
CONFIG_MULTIKERNEL_VSOCKETS=m

# The Ubuntu configs name certificate files that only exist in Ubuntu's tree.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# A build with DWARF does not fit on a hosted runner's disk. This also
# turns BTF off.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set

# Keep the result independent of whatever Rust toolchain the runner has.
# CONFIG_RUST is not set
